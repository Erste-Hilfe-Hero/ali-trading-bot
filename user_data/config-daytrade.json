{
  "bot_name": "ali-daytrade",
  "strategy": "DaytradeMomentum",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "EUR",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "spot",
  "timeframe": "5m",
  "dataformat_ohlcv": "feather",
  "unfilledtimeout": {
    "entry": 2,
    "exit": 2,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [],
    "pair_blacklist": [
      "USDC/.*",
      "FDUSD/.*",
      "TUSD/.*",
      "USD1/.*",
      "XUSD/.*",
      "USDE/.*",
      "BFUSD/.*",
      "RLUSD/.*",
      "U/.*",
      "XAUT/.*",
      "PAXG/.*",
      "SNDKB/.*",
      "SPCXB/.*",
      "SOXLB/.*",
      "TSLAB/.*",
      "CRCLB/.*",
      "MSTRB/.*",
      ".*UP/.*",
      ".*DOWN/.*"
    ]
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 50,
      "sort_key": "quoteVolume",
      "min_value": 5000000,
      "refresh_period": 1800
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 30
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.005
    },
    {
      "method": "PriceFilter",
      "low_price_ratio": 0.01
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "internals": {
    "process_throttle_secs": 5
  },
  "db_url": "sqlite:////freqtrade/user_data/tradesv3-daytrade.sqlite"
}