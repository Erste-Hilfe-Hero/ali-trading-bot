# Kopieren nach .env und ausfüllen. Die .env NIE auf GitHub hochladen.

# Binance API-Key des Sub-Accounts (nur "Spot Trading" erlauben, KEINE Auszahlungen, IP auf deinen VPS beschränken)
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Telegram: Token von @BotFather, Chat-ID von @userinfobot
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Erst auf "false" stellen, wenn der Bot mindestens 1-2 Wochen im Testmodus sauber lief
FREQTRADE__DRY_RUN=true
